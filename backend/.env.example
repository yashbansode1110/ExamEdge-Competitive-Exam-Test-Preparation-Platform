NODE_ENV=development
PORT=4001
MONGO_URI=mongodb://localhost:27017/examedge

JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

CORS_ORIGIN=http://localhost:5173

# Razorpay — use TEST keys in local dev (https://dashboard.razorpay.com/app/keys)
# Key ID must start with rzp_test_ for test checkout (INR, domestic test cards / UPI success@razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

OPENAI_API_KEY=your_api_key_here